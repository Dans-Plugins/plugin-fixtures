{
 "plugin": "Fiefs",
 "minecraftVersion": "26.1",
 "dataPaths": [
  "plugins/Fiefs",
  "plugins/MedievalFactions",
  "medieval_factions_db.*"
 ],
 "ignoreMessageKeys": [
  "PowerIncreased"
 ],
 "informationalMessageKeys": [
  "FiefClaimed",
  "FiefUnclaimed"
 ],
 "messagePatterns": [
  {
   "key": "PowerIncreased",
   "pattern": "^You feel stronger\\. Your power has increased by .*$"
  },
  {
   "key": "FiefLandRefused",
   "pattern": "^This land belongs to the fief .+\\. Only its members may do that here\\.$"
  },
  {
   "key": "CannotInteractWithBlockInFactionTerritory",
   "pattern": "^You cannot interact with blocks in .+ territory\\.$"
  },
  {
   "key": "CannotBreakBlockInFactionTerritory",
   "pattern": "^You cannot break blocks in .+ territory\\.$"
  },
  {
   "key": "CannotPlaceBlockInFactionTerritory",
   "pattern": "^You cannot place blocks in .+ territory\\.$"
  },
  {
   "key": "FiefOwnerOnly",
   "pattern": "^You must be the owner of your fief to .*$"
  },
  {
   "key": "FiefNotInFief",
   "pattern": "^You must be in a fief to use this command\\.$"
  },
  {
   "key": "FiefChunkAlreadyClaimed",
   "pattern": "^This chunk is already claimed by .+\\.$"
  },
  {
   "key": "FiefChunkNotYours",
   "pattern": "^That chunk doesn't belong to your fief\\.$"
  },
  {
   "key": "FiefClaimed",
   "pattern": "^Claimed\\.$"
  },
  {
   "key": "FiefUnclaimed",
   "pattern": "^Unclaimed\\.$"
  }
 ],
 "_comment": "RFC 0017 behaviour table for Fiefs, played on top of Medieval Factions (installed by the gate as a dependency). Each row is played by its role and by the control (Alice in her own fief's claim).",
