{
 "plugin": "Currencies",
 "minecraftVersion": "26.1",
 "dataPaths": [
  "plugins/Currencies",
  "plugins/MedievalFactions",
  "medieval_factions_db.*"
 ],
 "ignoreMessageKeys": [
  "PowerIncreased"
 ],
 "informationalMessageKeys": [
  "CurrencyMinted",
  "CurrencyRenamed",
  "CurrencyInfo",
  "CurrencyDescribed",
  "CurrencyCreated"
 ],
 "messagePatterns": [
  {
   "key": "CurrencyMinted",
   "pattern": "^Minted \\d+ x .+\\.$"
  },
  {
   "key": "CurrencyMintNoPermission",
   "pattern": "^Your role in this faction does not give you permission to mint this currency\\.$"
  },
  {
   "key": "CurrencyMintNoPower",
   "pattern": "^You need at least .* power to mint .*$"
  },
  {
   "key": "CurrencyMintNoItems",
   "pattern": "^You need at least \\d+ x .* to mint .*$"
  },
  {
   "key": "CurrencyRenamed",
   "pattern": "^Currency name changed from .+ to .+\\.$"
  },
  {
   "key": "CurrencyRenameNoPermission",
   "pattern": "^Your role in this faction does not give you permission to change the name of this currency\\.$"
  },
  {
   "key": "CurrencyNotFound",
   "pattern": "^There is no currency by that name\\.$"
  },
  {
   "key": "CurrencyNameTaken",
   "pattern": "^There is already a currency with that name\\.$"
  },
  {
   "key": "CurrencyInfo",
   "pattern": "^(=== .+ ===|Description:.*|Faction: .*|Item: .*|Minted: .*|Change name|Change description|Retire)$"
  },
  {
   "key": "CurrencyDescribed",
   "pattern": "^Currency description updated\\.$"
  },
  {
   "key": "CurrencyDescribeNoPermission",
   "pattern": "^Your role in this faction does not give you permission to change the description of this currency\\.$"
  },
  {
   "key": "CurrencyCreated",
   "pattern": "^Currency created\\.$"
  },
  {
   "key": "CurrencyCreateNoFaction",
   "pattern": "^You must be in a faction to create a currency\\.$"
  },
  {
   "key": "CurrencyCreateNoPermission",
   "pattern": "^Your role in this faction does not give you permission to create currencies\\.$"
  },
  {
   "key": "CurrencyRetireNoPermission",
   "pattern": "^Your role in this faction does not give you permission to retire this currency\\.$"
  },
  {
   "key": "CurrencyRetired",
   "pattern": "^Currency retired\\.$"
  }
 ],
 "ignoreLines": [
  "Alpha",
  "Bravo",
  "Echo"
 ],
 "_comment": "RFC 0017 behaviour table for Currencies, played on top of Medieval Factions (installed by the gate as a dependency). Rows are command rows: each is played by its role and by the control (Alice, who created AlphaCoin, running the same command).",
 "arenas": {
  "hall": {
   "chunk": [
    140,
    140
   ],
   "owner": null
  }
 },
